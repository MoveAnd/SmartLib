<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartlib.book.modular.edition.mapper.BookEditionMapper">

    <resultMap id="editionForEdit" type="com.smartlib.book.modular.edition.entity.BookEdition" autoMapping="true">
        <id column="key" property="key"/>
        <result column="data" property="data" javaType="com.fasterxml.jackson.databind.JsonNode"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
    </resultMap>

    <select id="selectForEdit" resultMap="editionForEdit">
        SELECT `key`,
               data
        FROM editions
        WHERE `key` = #{key}
          AND delete_flag = 'NOT_DELETE'
            FOR
        UPDATE
    </select>

</mapper>
